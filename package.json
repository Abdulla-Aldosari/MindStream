{
  "name": "mindstream-notes",
  "displayName": "MindStream - Notes",
  "description": "Capture notes and ideas as they happen, organize them into custom types and categories, and track their status.",
  "version": "1.0.0",
  "publisher": "Abdulla-Aldosari",
  "icon": "icons/mindstream.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdulla-Aldosari/MindStream.git"
  },
  "homepage": "https://github.com/Abdulla-Aldosari/MindStream#readme",
  "bugs": {
    "url": "https://github.com/Abdulla-Aldosari/MindStream/issues"
  },
  "keywords": [
    "notes",
    "note-taking",
    "notes-app",
    "note-manager",
    "quick-notes",
    "idea-capture",
    "productivity",
    "productivity-tools",
    "developer-tools",
    "markdown",
    "json",
    "weekly-report",
    "categories",
    "sidebar",
    "todo",
    "todo-app",
    "todo-list",
    "task-list",
    "task-management",
    "task-queue",
    "vscode-extension"
  ],
  "private": false,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mindstream",
          "title": "MindStream",
          "icon": "icons/mindstream.svg"
        }
      ]
    },
    "views": {
      "mindstream": [
        {
          "type": "webview",
          "id": "mindstream.sidebar",
          "name": "Notes",
          "icon": "icons/mindstream.svg",
          "contextualTitle": "MindStream"
        }
      ]
    },
    "commands": [
      {
        "command": "mindstream.addNote",
        "title": "Quick Note",
        "category": "MindStream",
        "icon": "$(add)"
      },
      {
        "command": "mindstream.addNoteToLine",
        "title": "Add note to this line",
        "category": "MindStream",
        "icon": "$(comment-add)"
      },
      {
        "command": "mindstream.manageTypes",
        "title": "Manage Types",
        "category": "MindStream",
        "icon": "$(tag)"
      },
      {
        "command": "mindstream.manageCategories",
        "title": "Manage Categories",
        "category": "MindStream",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "mindstream.refresh",
        "title": "Refresh",
        "category": "MindStream",
        "icon": "$(refresh)"
      },
      {
        "command": "mindstream.showSidebar",
        "title": "Open MindStream Panel",
        "category": "MindStream",
        "icon": "$(list-unordered)"
      },
      {
        "command": "mindstream.exportMarkdown",
        "title": "Export Markdown",
        "category": "MindStream",
        "icon": "$(markdown)"
      },
      {
        "command": "mindstream.exportJson",
        "title": "Export JSON",
        "category": "MindStream",
        "icon": "$(json)"
      },
      {
        "command": "mindstream.importJson",
        "title": "Import JSON",
        "category": "MindStream",
        "icon": "$(json)"
      },
      {
        "command": "mindstream.weeklyReport",
        "title": "Weekly Report",
        "category": "MindStream",
        "icon": "$(graph)"
      },
      {
        "command": "mindstream.exportWeeklyReport",
        "title": "Export Weekly Report",
        "category": "MindStream",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mindstream.addNoteToLine",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "mindstream@1"
        }
      ],
      "commandPalette": [
        {
          "command": "mindstream.addNoteToLine",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "mindstream.addNote",
          "when": "view == mindstream.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "mindstream.manageCategories",
          "when": "view == mindstream.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "mindstream.manageTypes",
          "when": "view == mindstream.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "mindstream.weeklyReport",
          "when": "view == mindstream.sidebar",
          "group": "navigation@4"
        },
        {
          "command": "mindstream.refresh",
          "when": "view == mindstream.sidebar",
          "group": "navigation@5"
        },
        {
          "submenu": "mindstream.more",
          "when": "view == mindstream.sidebar",
          "group": "navigation@6"
        }
      ],
      "mindstream.more": [
        {
          "command": "mindstream.exportMarkdown",
          "group": "1@1"
        },
        {
          "command": "mindstream.exportJson",
          "group": "1@2"
        },
        {
          "command": "mindstream.importJson",
          "group": "1@3"
        },
        {
          "command": "mindstream.exportWeeklyReport",
          "group": "1@4"
        }
      ]
    },
    "submenus": [
      {
        "id": "mindstream.more",
        "label": "More",
        "icon": "$(ellipsis)"
      }
    ],
    "keybindings": [
      {
        "command": "mindstream.addNote",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "title": "MindStream",
      "properties": {
        "mindstream.ui.direction": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ],
          "default": "ltr",
          "description": "Reading direction for note titles and descriptions. Use 'rtl' to read Arabic notes right-to-left; the interface keeps VS Code's default direction and all labels remain in English."
        },
        "mindstream.copy.includeNoteInfo": {
          "type": "boolean",
          "default": false,
          "description": "Include the note info section (category, type, status, and timestamps) when copying a note's content from the viewer."
        },
        "mindstream.priority.style": {
          "type": "string",
          "enum": [
            "dot",
            "stripe",
            "chip",
            "typeStripe",
            "off"
          ],
          "enumDescriptions": [
            "Dot before title: a small colored dot before the note title.",
            "Edge stripe: a colored stripe on the start edge of the card.",
            "Footer chip: a dot and the priority name next to the status.",
            "Stripe on type badge: a colored stripe on the end edge of the type badge.",
            "Disable the priority system: hides the priority on cards, the editor control, and the priority options in the View menu. Stored priorities are kept."
          ],
          "default": "chip",
          "description": "How note priority is shown on cards, or 'off' to disable the priority system."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "npm run compile && mocha",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prettier:check": "prettier --check .",
    "prettier": "prettier --write .",
    "changelog": "git-cliff -o CHANGELOG.md",
    "package": "npm run compile && vsce package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "git-cliff": "^2.14.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "playwright": "^1.65.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "lint-staged": {
    "*.{js,ts,json,css,md}": "prettier --write"
  }
}
